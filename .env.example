# Copy this file to .env and adjust for your environment.
# Production values are set in Cloudflare Pages → Settings → Environment variables.
APP_URL=http://app.lvh.me:3000

# Contact form — Mailgun API (not SMTP)
# Get from Mailgun → Account → API Keys
MAILGUN_API_KEY=
MAILGUN_DOMAIN=

# Spam protection — Cloudflare Turnstile
# Cloudflare dashboard → Turnstile → Add site → copy both keys
# PUBLIC_ prefix makes the site key available client-side
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
