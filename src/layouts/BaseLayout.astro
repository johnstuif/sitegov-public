---
import { APP_URL } from '../config';

interface Props {
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  currentPage?: string;
}

const {
  title,
  description,
  ogTitle,
  ogDescription,
  currentPage = '',
} = Astro.props;

const navLinks = [
  { href: '/#solution', label: 'How it works' },
  { href: '/what-is-sitegov', label: 'What is SiteGov?' },
  { href: '/use-cases', label: 'Use Cases' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline src="https://app.termly.io/resource-blocker/12ddec9b-c200-4647-a901-fa93713ab689?autoBlock=on"></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <meta name="description" content={description} />
    {ogTitle && <meta property="og:title" content={ogTitle} />}
    {ogDescription && <meta property="og:description" content={ogDescription} />}
    <meta property="og:type" content="website" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/sg-icon.css" />
    <style is:global>
      html { scroll-behavior: smooth; }

      /* §11 — 14px dot grain on section-level paper surfaces */
      .paper-grain {
        background-image: radial-gradient(rgba(20,23,30,0.055) 1px, transparent 1px);
        background-size: 14px 14px;
      }

      /* Corner bracket frames — amber for dark cards, teal for light cards.
         Each corner uses two layers: a horizontal stroke and a vertical stroke.
         The vertical stroke is offset by 2px so it starts where the horizontal ends,
         preventing the semi-transparent layers from doubling up at the corner pixel. */
      .frame-amber {
        background-image:
          linear-gradient(rgb(245 158 11 / 0.5), rgb(245 158 11 / 0.5)),
          linear-gradient(rgb(245 158 11 / 0.5), rgb(245 158 11 / 0.5)),
          linear-gradient(rgb(245 158 11 / 0.5), rgb(245 158 11 / 0.5)),
          linear-gradient(rgb(245 158 11 / 0.5), rgb(245 158 11 / 0.5)),
          linear-gradient(rgb(245 158 11 / 0.5), rgb(245 158 11 / 0.5)),
          linear-gradient(rgb(245 158 11 / 0.5), rgb(245 158 11 / 0.5)),
          linear-gradient(rgb(245 158 11 / 0.5), rgb(245 158 11 / 0.5)),
          linear-gradient(rgb(245 158 11 / 0.5), rgb(245 158 11 / 0.5));
        background-size:     16px 2px, 2px 14px, 16px 2px, 2px 14px, 16px 2px, 2px 14px, 16px 2px, 2px 14px;
        background-position: top left, 0px 2px, top right, right 0px top 2px, bottom left, left 0px bottom 2px, bottom right, right 0px bottom 2px;
        background-repeat: no-repeat;
        background-origin: border-box;
      }
      .frame-teal {
        background-image:
          linear-gradient(rgb(20 184 166 / 0.5), rgb(20 184 166 / 0.5)),
          linear-gradient(rgb(20 184 166 / 0.5), rgb(20 184 166 / 0.5)),
          linear-gradient(rgb(20 184 166 / 0.5), rgb(20 184 166 / 0.5)),
          linear-gradient(rgb(20 184 166 / 0.5), rgb(20 184 166 / 0.5)),
          linear-gradient(rgb(20 184 166 / 0.5), rgb(20 184 166 / 0.5)),
          linear-gradient(rgb(20 184 166 / 0.5), rgb(20 184 166 / 0.5)),
          linear-gradient(rgb(20 184 166 / 0.5), rgb(20 184 166 / 0.5)),
          linear-gradient(rgb(20 184 166 / 0.5), rgb(20 184 166 / 0.5));
        background-size:     16px 2px, 2px 14px, 16px 2px, 2px 14px, 16px 2px, 2px 14px, 16px 2px, 2px 14px;
        background-position: top left, 0px 2px, top right, right 0px top 2px, bottom left, left 0px bottom 2px, bottom right, right 0px bottom 2px;
        background-repeat: no-repeat;
        background-origin: border-box;
      }

      /* §11 — 32px blueprint grid for topology/engineering contexts */
      .bg-grid {
        background-image:
          linear-gradient(to right, rgba(20,23,30,0.06) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(20,23,30,0.06) 1px, transparent 1px);
        background-size: 32px 32px;
      }

      /* §11 — Night grid for dark hero/CTA sections */
      .bg-grid-night {
        background-image:
          linear-gradient(to right, rgba(229,227,220,0.05) 1px, transparent 1px),
          linear-gradient(to bottom, rgba(229,227,220,0.05) 1px, transparent 1px);
        background-size: 32px 32px;
      }

      /* §11 — Marketing signal pills (round; different from app sq pills) */
      .mkt-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 3px 8px;
        border-radius: 999px;
        font-family: 'IBM Plex Mono', ui-monospace, monospace;
        font-size: 10.5px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        border: 1px solid rgba(20,23,30,0.18);
        color: #4B4E55;
        background: rgba(255,255,255,0.6);
      }
      .mkt-pill .mkt-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: #82848B;
        flex-shrink: 0;
      }
      .mkt-pill.healthy .mkt-dot { background: oklch(0.74 0.08 180); }
      .mkt-pill.warn    .mkt-dot { background: oklch(0.74 0.13 60); }
      .mkt-pill.critical .mkt-dot { background: oklch(0.62 0.16 25); }

    </style>

    {import.meta.env.PROD && (
      <Fragment>
        <script async src="https://www.googletagmanager.com/gtag/js?id=G-VLEGXYTEW7"></script>
        <script is:inline>
          window.dataLayer = window.dataLayer || [];
          function gtag(){dataLayer.push(arguments);}
          gtag('js', new Date());
          gtag('config', 'G-VLEGXYTEW7');
        </script>
      </Fragment>
    )}
  </head>
  <body class="bg-white text-slate-900 antialiased">

    <header class="sticky top-0 z-50 bg-white/90 backdrop-blur border-b border-slate-100">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <a href="/" class="sg-logo flex items-center gap-2.5">
          <div class="sg-icon-wrap" style="width:28px;height:28px;">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="28" height="28">
              <path d="M32 10 L51.05 21 L51.05 43 L32 54 L12.95 43 L12.95 21 Z" fill="none" stroke="#0B1F3A" stroke-width="2.5" stroke-linejoin="round"/>
              <g stroke="#0B1F3A" stroke-width="1.8" stroke-linecap="round" opacity="0.6">
                <line x1="32" y1="10" x2="32" y2="32"/>
                <line x1="51.05" y1="21" x2="32" y2="32"/>
                <line x1="51.05" y1="43" x2="32" y2="32"/>
                <line x1="32" y1="54" x2="32" y2="32"/>
                <line x1="12.95" y1="43" x2="32" y2="32"/>
                <line x1="12.95" y1="21" x2="32" y2="32"/>
              </g>
              <circle class="sg-n1" cx="32"    cy="10"  r="2.8" fill="#0B1F3A"/>
              <circle class="sg-n2" cx="51.05" cy="21"  r="2.8" fill="#0B1F3A"/>
              <circle class="sg-n3" cx="51.05" cy="43"  r="2.8" fill="#0B1F3A"/>
              <circle class="sg-n4" cx="32"    cy="54"  r="2.8" fill="#0B1F3A"/>
              <circle class="sg-n5" cx="12.95" cy="43"  r="2.8" fill="#0B1F3A"/>
              <circle class="sg-n6" cx="12.95" cy="21"  r="2.8" fill="#0B1F3A"/>
              <circle class="sg-ring" cx="32"  cy="32"  r="5"   fill="none" stroke="#2E7CF6" stroke-width="1.5"/>
              <circle cx="32" cy="32" r="5" fill="#2E7CF6"/>
            </svg>
          </div>
          <span class="text-xl font-semibold tracking-tight" style="color:#0B1F3A;">SiteGov</span>
        </a>
        <nav class="hidden md:flex items-center gap-8 text-sm text-slate-600">
          {navLinks.map(({ href, label }) => (
            <a
              href={href}
              class={currentPage === label
                ? 'text-slate-900 font-medium'
                : 'hover:text-slate-900 transition-colors'}
            >
              {label}
            </a>
          ))}
        </nav>
        <div class="flex items-center gap-3">
          <a href={`${APP_URL}/users/sign_in`} class="text-sm text-slate-600 hover:text-slate-900 transition-colors hidden sm:inline">Sign In</a>
          <a href={`${APP_URL}/users/sign_up`} class="inline-flex items-center px-4 py-2 bg-slate-900 text-white text-sm font-medium rounded-lg hover:bg-slate-700 transition-colors">
            Start for free
          </a>
          <button id="mobile-menu-btn" class="md:hidden -mr-1 p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 transition-colors" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
            <svg id="icon-hamburger" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    <div id="mobile-menu" class="hidden fixed top-16 inset-x-0 bottom-0 z-40 bg-white paper-grain border-t border-slate-100 flex-col overflow-y-auto md:hidden">
      <nav class="flex flex-col">
        {navLinks.map(({ href, label }) => (
          <a
            href={href}
            class={`mobile-nav-link border-b border-slate-100 px-6 py-4 text-base transition-colors ${currentPage === label ? 'text-slate-900 font-medium' : 'text-slate-600 hover:text-slate-900'}`}
          >
            {label}
          </a>
        ))}
      </nav>
      <div class="px-6 py-6 flex flex-col gap-3 border-t border-slate-100 mt-auto">
        <a href={`${APP_URL}/users/sign_in`} class="flex items-center justify-center px-4 py-3 rounded-lg border border-slate-200 text-sm font-medium text-slate-700 hover:bg-slate-50 transition-colors">
          Sign In
        </a>
        <a href={`${APP_URL}/users/sign_up`} class="flex items-center justify-center px-4 py-3 rounded-lg bg-slate-900 text-white text-sm font-medium hover:bg-slate-700 transition-colors">
          Start for free
        </a>
      </div>
    </div>

    <slot />

    <footer class="border-t border-slate-100 py-12">
      <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-start md:items-center justify-between gap-8">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <div class="sg-icon-wrap" style="width:20px;height:20px;">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64" width="20" height="20">
                <path d="M32 10 L51.05 21 L51.05 43 L32 54 L12.95 43 L12.95 21 Z" fill="none" stroke="#0B1F3A" stroke-width="2.5" stroke-linejoin="round"/>
                <g stroke="#0B1F3A" stroke-width="1.8" stroke-linecap="round" opacity="0.6">
                  <line x1="32" y1="10" x2="32" y2="32"/>
                  <line x1="51.05" y1="21" x2="32" y2="32"/>
                  <line x1="51.05" y1="43" x2="32" y2="32"/>
                  <line x1="32" y1="54" x2="32" y2="32"/>
                  <line x1="12.95" y1="43" x2="32" y2="32"/>
                  <line x1="12.95" y1="21" x2="32" y2="32"/>
                </g>
                <circle class="sg-n1" cx="32"    cy="10"  r="2.8" fill="#0B1F3A"/>
                <circle class="sg-n2" cx="51.05" cy="21"  r="2.8" fill="#0B1F3A"/>
                <circle class="sg-n3" cx="51.05" cy="43"  r="2.8" fill="#0B1F3A"/>
                <circle class="sg-n4" cx="32"    cy="54"  r="2.8" fill="#0B1F3A"/>
                <circle class="sg-n5" cx="12.95" cy="43"  r="2.8" fill="#0B1F3A"/>
                <circle class="sg-n6" cx="12.95" cy="21"  r="2.8" fill="#0B1F3A"/>
                <circle class="sg-ring" cx="32"  cy="32"  r="5"   fill="none" stroke="#2E7CF6" stroke-width="1.5"/>
                <circle cx="32" cy="32" r="5" fill="#2E7CF6"/>
              </svg>
            </div>
            <span class="font-semibold text-slate-900">SiteGov</span>
          </div>
          <p class="text-xs text-slate-500 whitespace-nowrap">For agencies managing client domains, DNS, hosting, and SSL.</p>
        </div>
        <div class="flex flex-col items-start md:items-end gap-3">
          <div class="flex flex-wrap gap-6 text-xs text-slate-400">
            <a href="/#solution" class="hover:text-slate-700 transition-colors">How it works</a>
            <a href="/what-is-sitegov" class="hover:text-slate-700 transition-colors">What is SiteGov?</a>
            <a href="/use-cases" class="hover:text-slate-700 transition-colors">Use Cases</a>
            <a href="/pricing" class="hover:text-slate-700 transition-colors">Pricing</a>
            <a href={`${APP_URL}/users/sign_in`} class="hover:text-slate-700 transition-colors">Sign In</a>
            <a href="/contact" class="hover:text-slate-700 transition-colors">Contact</a>
          </div>
          <div class="flex flex-wrap gap-6 text-xs text-slate-400">
            <a href="/privacy" class="hover:text-slate-700 transition-colors">Privacy</a>
            <a href="/terms" class="hover:text-slate-700 transition-colors">Terms</a>
            <a href="/cookie-policy" class="hover:text-slate-700 transition-colors">Cookies</a>
            <a href="#" class="termly-display-preferences hover:text-slate-700 transition-colors">Consent Preferences</a>
          </div>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      const iconHamburger = document.getElementById('icon-hamburger');
      const iconClose = document.getElementById('icon-close');

      function openMenu() {
        menu.classList.remove('hidden');
        menu.classList.add('flex');
        iconHamburger.classList.add('hidden');
        iconClose.classList.remove('hidden');
        btn.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      function closeMenu() {
        menu.classList.add('hidden');
        menu.classList.remove('flex');
        iconHamburger.classList.remove('hidden');
        iconClose.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }

      btn.addEventListener('click', () => {
        menu.classList.contains('hidden') ? openMenu() : closeMenu();
      });

      document.querySelectorAll('.mobile-nav-link').forEach(link => {
        link.addEventListener('click', closeMenu);
      });

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') closeMenu();
      });
    </script>
  </body>
</html>
