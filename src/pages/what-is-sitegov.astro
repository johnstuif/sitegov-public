---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is website infrastructure tracking?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Website infrastructure tracking is the practice of documenting who controls every system behind a domain: who registered it, who manages the DNS, who runs the hosting, who owns the SSL cert, and who holds the credentials for each. Most organizations have this knowledge scattered across people\'s heads, email threads, and stale spreadsheets. SiteGov makes it explicit and accessible before the moment it\'s needed.',
      },
    },
    {
      '@type': 'Question',
      name: 'Why separate domain ownership from DNS control?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Because they\'re often different people. The domain might be registered under a founder\'s personal email. DNS might be managed by a vendor the client switched last year. Hosting might be on a developer\'s agency account. Each is a separate access point, and any one of them can fail independently.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this a security tool?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Not primarily. Security tools look for vulnerabilities: open ports, malware, injection risks. SiteGov looks for access gaps: expired certs, missing backup admins, undocumented credentials, former employees still listed as primary contacts. A site can pass a security scan and still be inaccessible the moment the one person who knows the registrar login leaves the company.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does this replace password managers?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. A password manager stores credentials. SiteGov documents that credentials exist, who holds them, where they\'re stored, and whether access recovery is documented. It answers "do we have access?" without holding the passwords themselves. Use a password manager to store credentials, use SiteGov to confirm the right people have access and every account has a named owner.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is vendor dependency risk?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'When a critical infrastructure layer is controlled by a vendor whose relationship with your client has changed — an old agency still holding DNS, a contractor who left with hosting credentials, a previous developer whose email is still the registrar contact — your ability to act on that domain depends on their cooperation. SiteGov makes vendor dependencies visible before they become blockers.',
      },
    },
  ],
};
---

<BaseLayout
  title="What is SiteGov? | Website Infrastructure Tracking Explained"
  description="Website infrastructure tracking means documenting who controls every system behind a domain: the registrar, DNS, hosting, SSL, and email provider. Before the moment you need it."
  currentPage="What is SiteGov?"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="bg-slate-950 text-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-4">What is SiteGov?</p>
        <h1 class="text-5xl font-bold leading-tight tracking-tight mb-6">
          Website infrastructure tracking for agencies.
        </h1>
        <p class="text-lg text-slate-400 leading-relaxed mb-6">
          Every domain has a registrar, a DNS provider, a hosting platform, an SSL authority, and an email system. Each one has an account. Each account has a login. At any given moment, someone either knows who controls that login. Or they don&rsquo;t.
        </p>
        <p class="text-base text-slate-500 leading-relaxed">
          SiteGov maps that picture from live data and gives your team a structured record of who controls what, before the moment you need it.
        </p>
      </div>
    </div>
  </section>

  <!-- Provider stack -->
  <section class="py-20 border-b border-slate-100 bg-slate-50">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">The provider stack</p>
          <h2 class="text-3xl font-bold leading-tight mb-6">Five layers. Five accounts. Five potential gaps.</h2>
          <p class="text-slate-500 text-base leading-relaxed mb-4">
            Every domain runs on a stack of independent providers. The registrar holds the domain registration. DNS routes traffic to the right servers. Hosting serves the pages. SSL secures the connection. Email runs through its own platform entirely.
          </p>
          <p class="text-slate-500 text-base leading-relaxed mb-4">
            Each layer is separate. Each has its own account. Each account has a login. Most organizations assume these are all connected &mdash; that whoever manages the domain also controls DNS, or that the developer who set up hosting also manages SSL.
          </p>
          <p class="text-slate-500 text-base leading-relaxed">
            They usually aren&rsquo;t. DNS is often managed by a different vendor than the registrar. Hosting is often on a developer&rsquo;s agency account. SSL auto-renews through a service nobody monitors. Email predates every agency relationship by a decade. The result: five layers, five potential access gaps, rarely documented together.
          </p>
        </div>
        <div class="space-y-1">
          <div class="bg-white px-5 py-4 flex items-center justify-between gap-4 frame-teal">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Registrar</p>
              <p class="text-slate-600 text-sm">Holds the domain registration. Controls who can transfer or renew.</p>
            </div>
            <p class="text-slate-400 text-xs text-right shrink-0">GoDaddy &middot; Namecheap</p>
          </div>
          <div class="flex justify-center py-0.5">
            <svg class="w-4 h-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </div>
          <div class="bg-white px-5 py-4 flex items-center justify-between gap-4 frame-teal">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">DNS</p>
              <p class="text-slate-600 text-sm">Routes traffic to the right servers. Controls where the domain points.</p>
            </div>
            <p class="text-slate-400 text-xs text-right shrink-0">Cloudflare &middot; Route 53</p>
          </div>
          <div class="flex justify-center py-0.5">
            <svg class="w-4 h-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </div>
          <div class="bg-white px-5 py-4 flex items-center justify-between gap-4 frame-teal">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Hosting</p>
              <p class="text-slate-600 text-sm">Serves the site. Controls what appears when the domain loads.</p>
            </div>
            <p class="text-slate-400 text-xs text-right shrink-0">WP Engine &middot; Vercel</p>
          </div>
          <div class="flex justify-center py-0.5">
            <svg class="w-4 h-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </div>
          <div class="bg-white px-5 py-4 flex items-center justify-between gap-4 frame-teal">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">SSL</p>
              <p class="text-slate-600 text-sm">Secures the connection. Expires on a fixed date, regardless of who&rsquo;s watching.</p>
            </div>
            <p class="text-slate-400 text-xs text-right shrink-0">Let&rsquo;s Encrypt &middot; DigiCert</p>
          </div>
          <div class="flex justify-center py-0.5">
            <svg class="w-4 h-4 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" /></svg>
          </div>
          <div class="bg-white px-5 py-4 flex items-center justify-between gap-4 frame-teal">
            <div>
              <p class="text-xs font-semibold text-slate-400 uppercase tracking-widest mb-1">Email</p>
              <p class="text-slate-600 text-sm">Runs independently from everything else. Often the oldest account nobody&rsquo;s touched.</p>
            </div>
            <p class="text-slate-400 text-xs text-right shrink-0">Google Workspace &middot; M365</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Definitional FAQ -->
  <section class="py-20 border-b border-slate-100">
    <div class="max-w-3xl mx-auto px-6">
      <div class="mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">Understanding the category</p>
        <h2 class="text-3xl font-bold leading-tight">The questions behind the question.</h2>
      </div>
      <div class="divide-y divide-slate-100">

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">What is website infrastructure tracking?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Website infrastructure tracking is the practice of documenting who controls every system behind a domain: who registered it, who manages the DNS, who runs the hosting, who owns the SSL cert, and who holds the credentials for each. Most organizations have this knowledge scattered across people&rsquo;s heads, email threads, and stale spreadsheets. SiteGov makes it explicit and accessible before the moment it&rsquo;s needed.</p>
        </div>

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">Why separate domain ownership from DNS control?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Because they&rsquo;re often different people. The domain might be registered under a founder&rsquo;s personal email. DNS might be managed by a vendor the client switched last year. Hosting might be on a developer&rsquo;s agency account. Each is a separate access point, and any one of them can fail independently. When they&rsquo;re documented separately, you can see the full picture. When they&rsquo;re assumed to be the same, you find out they&rsquo;re not at the worst possible time.</p>
        </div>

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">Is this a security tool?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Not primarily. Security tools look for vulnerabilities: open ports, malware, injection risks. SiteGov looks for access gaps: expired certs, missing backup admins, undocumented credentials, former employees still listed as primary contacts. The distinction matters. A site can pass a security scan and still be inaccessible the moment the one person who knows the registrar login leaves the company.</p>
        </div>

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">Does this replace password managers?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">No. A password manager stores credentials. SiteGov documents that credentials exist, who holds them, where they&rsquo;re stored, and whether access recovery is documented. It answers &ldquo;do we have access?&rdquo; without holding the passwords themselves. The two tools are complementary: use a password manager to store credentials, use SiteGov to confirm the right people have access and every account has a named owner.</p>
        </div>

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">What is vendor dependency risk?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">When a critical infrastructure layer is controlled by a vendor whose relationship with your client has changed &mdash; an old agency still holding DNS, a contractor who left with hosting credentials, a previous developer whose email is still the registrar contact &mdash; your ability to act on that domain depends on their cooperation. You can&rsquo;t migrate, change providers, or go live without their involvement, regardless of who the domain technically belongs to. SiteGov makes vendor dependencies visible before they become blockers. Every infrastructure layer shows who controls the account, not just which provider is running the service. When a vendor relationship ends, the governance record tells you exactly what needs to be transferred and who needs to do it.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Comparison -->
  <section class="bg-slate-50 py-20 border-b border-slate-100">
    <div class="max-w-4xl mx-auto px-6">
      <div class="mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">How it fits</p>
        <h2 class="text-3xl font-bold leading-tight mb-4">Not a replacement. A missing layer.</h2>
        <p class="text-slate-500 text-base leading-relaxed">Agencies already use tools that do adjacent things. SiteGov doesn&rsquo;t replace any of them. It answers a question none of them answer.</p>
      </div>
      <div class="divide-y divide-slate-200 border-y border-slate-200">
        <div class="py-6 grid md:grid-cols-3 gap-2">
          <p class="text-slate-900 font-semibold text-sm">Spreadsheet</p>
          <p class="text-slate-500 text-sm leading-relaxed md:col-span-2">Records what someone typed, when they typed it. Doesn&rsquo;t know the registrar changed last Tuesday, the SSL expires in 11 days, or that the person who wrote it down left the company.</p>
        </div>
        <div class="py-6 grid md:grid-cols-3 gap-2">
          <p class="text-slate-900 font-semibold text-sm">Password manager</p>
          <p class="text-slate-500 text-sm leading-relaxed md:col-span-2">Stores credentials securely. Doesn&rsquo;t tell you who the backup admin is, whether MFA is confirmed on the account, or whether the primary contact still works at the company.</p>
        </div>
        <div class="py-6 grid md:grid-cols-3 gap-2">
          <p class="text-slate-900 font-semibold text-sm">Security scanner</p>
          <p class="text-slate-500 text-sm leading-relaxed md:col-span-2">Finds exploitable vulnerabilities: open ports, injection risks, outdated software. Doesn&rsquo;t tell you who controls the registrar or whether your team can access the DNS panel if something breaks.</p>
        </div>
        <div class="py-6 grid md:grid-cols-3 gap-2">
          <p class="text-slate-900 font-semibold text-sm">Uptime monitor</p>
          <p class="text-slate-500 text-sm leading-relaxed md:col-span-2">Tells you when the site goes down. Doesn&rsquo;t tell you who to call, who controls the infrastructure, or whether anyone on your team can actually fix it.</p>
        </div>
        <div class="py-6 grid md:grid-cols-3 gap-2">
          <p class="text-teal-700 font-semibold text-sm">SiteGov</p>
          <p class="text-slate-600 text-sm leading-relaxed md:col-span-2">Documents who controls each provider, whether a second person can get in if the first is unavailable, and whether access recovery is actually in place. The question every one of the above tools assumes someone else is answering.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-white border-t border-slate-200 py-24">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-6">Get started</p>
      <h2 class="text-4xl font-bold leading-tight mb-6">
        See what&rsquo;s actually running behind your client sites.
      </h2>
      <p class="text-slate-500 text-xl mb-10 leading-relaxed">
        Add a domain and run your first scan. You might be surprised what turns up.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={`${APP_URL}/users/sign_up`} class="inline-flex items-center justify-center px-8 py-4 bg-slate-900 text-white text-sm font-semibold rounded-lg hover:bg-slate-700 transition-colors">
          Find your gaps
        </a>
        <a href="/use-cases" class="inline-flex items-center justify-center px-8 py-4 bg-white text-slate-700 text-sm font-medium rounded-lg border border-slate-200 hover:border-slate-400 transition-colors">
          See use cases
        </a>
      </div>
      <p class="mt-4 text-xs text-slate-400">No credit card required. Five minutes to find out what nobody on your team actually knows.</p>
    </div>
  </section>

</BaseLayout>
