---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL } from '../config';
---

<BaseLayout
  title="About SiteGov | Built from 25 Years of Agency Work"
  description="SiteGov was built after 25 years of web work and hundreds of encounters with the same infrastructure ownership problems across clients, industries, and years."
  currentPage="About"
>

  <!-- Hero -->
  <section class="relative bg-slate-950 text-white">
    <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle, rgba(148,163,184,0.35) 1px, transparent 1px); background-size: 32px 32px; opacity: 0.08;"></div>
    </div>

    <!-- Infrastructure network: extends from hero into pattern section below -->
    <div class="absolute right-0 top-0 w-[55%] h-[1400px] pointer-events-none select-none" aria-hidden="true">
      <svg class="w-full h-full opacity-[0.20]" viewBox="0 0 700 1400" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMin meet">
        <defs>
          <linearGradient id="net" x1="0" y1="0" x2="0" y2="1400" gradientUnits="userSpaceOnUse">
            <stop offset="0%" stop-color="#94a3b8"/>
            <stop offset="38%" stop-color="#94a3b8"/>
            <stop offset="48%" stop-color="#475569"/>
            <stop offset="100%" stop-color="#475569"/>
          </linearGradient>
        </defs>
        <!-- Scatter dots: hero area -->
        <circle cx="620" cy="35" r="1.5" fill="url(#net)"/>
        <circle cx="480" cy="20" r="1" fill="url(#net)"/>
        <circle cx="340" cy="55" r="1.5" fill="url(#net)"/>
        <circle cx="660" cy="110" r="1" fill="url(#net)"/>
        <circle cx="680" cy="200" r="1.5" fill="url(#net)"/>
        <circle cx="650" cy="320" r="1" fill="url(#net)"/>
        <circle cx="630" cy="440" r="1.5" fill="url(#net)"/>
        <circle cx="80" cy="200" r="1.5" fill="url(#net)"/>
        <circle cx="50" cy="380" r="1" fill="url(#net)"/>
        <circle cx="200" cy="80" r="1.5" fill="url(#net)"/>
        <!-- Scatter dots: continuation -->
        <circle cx="600" cy="600" r="1.5" fill="url(#net)"/>
        <circle cx="660" cy="730" r="1" fill="url(#net)"/>
        <circle cx="630" cy="870" r="1.5" fill="url(#net)"/>
        <circle cx="650" cy="1010" r="1" fill="url(#net)"/>
        <circle cx="30" cy="630" r="1" fill="url(#net)"/>
        <circle cx="60" cy="780" r="1.5" fill="url(#net)"/>
        <circle cx="40" cy="940" r="1" fill="url(#net)"/>
        <circle cx="430" cy="1120" r="1" fill="url(#net)"/>
        <circle cx="310" cy="1220" r="1.5" fill="url(#net)"/>
        <circle cx="600" cy="1500" r="1.5" fill="url(#net)"/>
        <circle cx="650" cy="1750" r="1" fill="url(#net)"/>
        <circle cx="620" cy="2000" r="1.5" fill="url(#net)"/>
        <circle cx="640" cy="2300" r="1" fill="url(#net)"/>
        <circle cx="600" cy="2600" r="1.5" fill="url(#net)"/>
        <circle cx="650" cy="2900" r="1" fill="url(#net)"/>
        <circle cx="620" cy="3200" r="1.5" fill="url(#net)"/>
        <circle cx="640" cy="3500" r="1" fill="url(#net)"/>
        <circle cx="600" cy="3800" r="1.5" fill="url(#net)"/>
        <circle cx="640" cy="4100" r="1" fill="url(#net)"/>
        <circle cx="610" cy="4400" r="1.5" fill="url(#net)"/>
        <circle cx="30" cy="1450" r="1" fill="url(#net)"/>
        <circle cx="55" cy="1900" r="1.5" fill="url(#net)"/>
        <circle cx="35" cy="2400" r="1" fill="url(#net)"/>
        <circle cx="60" cy="2900" r="1.5" fill="url(#net)"/>
        <circle cx="35" cy="3400" r="1" fill="url(#net)"/>
        <circle cx="55" cy="3900" r="1.5" fill="url(#net)"/>
        <circle cx="35" cy="4400" r="1" fill="url(#net)"/>
        <!-- Edges: hero (solid) -->
        <line x1="580" y1="100" x2="420" y2="190" stroke="url(#net)" stroke-width="0.75"/>
        <line x1="420" y1="190" x2="560" y2="280" stroke="url(#net)" stroke-width="0.75"/>
        <line x1="420" y1="190" x2="280" y2="320" stroke="url(#net)" stroke-width="0.75"/>
        <line x1="560" y1="280" x2="460" y2="400" stroke="url(#net)" stroke-width="0.75"/>
        <line x1="280" y1="320" x2="200" y2="420" stroke="url(#net)" stroke-width="0.75"/>
        <line x1="460" y1="400" x2="360" y2="470" stroke="url(#net)" stroke-width="0.75"/>
        <!-- Edges: dashed, crossing hero boundary -->
        <line x1="200" y1="420" x2="360" y2="470" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="360" y1="470" x2="240" y2="680" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="200" y1="420" x2="120" y2="700" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <!-- Edges: through Pattern section -->
        <line x1="240" y1="680" x2="300" y2="880" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="120" y1="700" x2="80" y2="920" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="300" y1="880" x2="180" y2="1080" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <!-- Edges: extended continuation to CTA -->
        <line x1="180" y1="1080" x2="260" y2="1280" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="80" y1="920" x2="100" y2="1440" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="260" y1="1280" x2="310" y2="1560" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="100" y1="1440" x2="160" y2="1720" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="310" y1="1560" x2="280" y2="1900" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="160" y1="1720" x2="120" y2="2060" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="280" y1="1900" x2="300" y2="2240" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="120" y1="2060" x2="200" y2="2420" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="300" y1="2240" x2="340" y2="2620" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="200" y1="2420" x2="160" y2="2800" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="340" y1="2620" x2="280" y2="3000" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="160" y1="2800" x2="140" y2="3180" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="280" y1="3000" x2="260" y2="3400" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="140" y1="3180" x2="180" y2="3600" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="260" y1="3400" x2="300" y2="3800" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="180" y1="3600" x2="160" y2="4000" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="300" y1="3800" x2="240" y2="4200" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="160" y1="4000" x2="180" y2="4400" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="240" y1="4200" x2="260" y2="4650" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <line x1="180" y1="4400" x2="200" y2="4800" stroke="url(#net)" stroke-width="0.75" stroke-dasharray="4 3"/>
        <!-- Nodes: hero area -->
        <circle cx="580" cy="100" r="4.5" fill="url(#net)"/>
        <circle cx="420" cy="190" r="4.5" fill="url(#net)"/>
        <circle cx="560" cy="280" r="4.5" fill="url(#net)"/>
        <circle cx="280" cy="320" r="4.5" fill="url(#net)"/>
        <circle cx="460" cy="400" r="4.5" fill="url(#net)"/>
        <circle cx="200" cy="420" r="4.5" fill="url(#net)"/>
        <circle cx="360" cy="470" r="4" fill="url(#net)"/>
        <!-- Nodes: pattern area -->
        <circle cx="240" cy="680" r="3.5" fill="url(#net)"/>
        <circle cx="120" cy="700" r="3" fill="url(#net)"/>
        <circle cx="300" cy="880" r="3" fill="url(#net)"/>
        <circle cx="80" cy="920" r="2.5" fill="url(#net)"/>
        <circle cx="180" cy="1080" r="2" fill="url(#net)"/>
        <!-- Nodes: extended continuation (progressively smaller) -->
        <circle cx="260" cy="1280" r="2" fill="url(#net)"/>
        <circle cx="100" cy="1440" r="2" fill="url(#net)"/>
        <circle cx="310" cy="1560" r="1.5" fill="url(#net)"/>
        <circle cx="160" cy="1720" r="1.5" fill="url(#net)"/>
        <circle cx="280" cy="1900" r="1.5" fill="url(#net)"/>
        <circle cx="120" cy="2060" r="1.5" fill="url(#net)"/>
        <circle cx="300" cy="2240" r="1" fill="url(#net)"/>
        <circle cx="200" cy="2420" r="1" fill="url(#net)"/>
        <circle cx="340" cy="2620" r="1" fill="url(#net)"/>
        <circle cx="160" cy="2800" r="1" fill="url(#net)"/>
        <circle cx="280" cy="3000" r="1" fill="url(#net)"/>
        <circle cx="140" cy="3180" r="1" fill="url(#net)"/>
        <circle cx="260" cy="3400" r="1" fill="url(#net)"/>
        <circle cx="180" cy="3600" r="1" fill="url(#net)"/>
        <circle cx="300" cy="3800" r="1" fill="url(#net)"/>
        <circle cx="160" cy="4000" r="1" fill="url(#net)"/>
        <circle cx="240" cy="4200" r="1" fill="url(#net)"/>
        <circle cx="180" cy="4400" r="1" fill="url(#net)"/>
        <circle cx="260" cy="4650" r="1" fill="url(#net)"/>
        <circle cx="200" cy="4800" r="1" fill="url(#net)"/>
        <!-- Labels: hero area only -->
        <text x="580" y="84" text-anchor="middle" fill="url(#net)" font-size="9" font-family="monospace" letter-spacing="1">REGISTRAR</text>
        <text x="420" y="174" text-anchor="middle" fill="url(#net)" font-size="9" font-family="monospace" letter-spacing="1">DNS</text>
        <text x="560" y="264" text-anchor="middle" fill="url(#net)" font-size="9" font-family="monospace" letter-spacing="1">HOSTING</text>
        <text x="280" y="304" text-anchor="middle" fill="url(#net)" font-size="9" font-family="monospace" letter-spacing="1">NAMESERVERS</text>
        <text x="460" y="384" text-anchor="middle" fill="url(#net)" font-size="9" font-family="monospace" letter-spacing="1">SSL</text>
        <text x="200" y="404" text-anchor="middle" fill="url(#net)" font-size="9" font-family="monospace" letter-spacing="1">EMAIL</text>
        <text x="360" y="454" text-anchor="middle" fill="url(#net)" font-size="9" font-family="monospace" letter-spacing="1">CDN</text>
      </svg>
    </div>

    <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-amber-500/25 to-transparent"></div>

    <div class="relative z-[1] max-w-6xl mx-auto px-6 pt-24 pb-20">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-4">About SiteGov</p>
        <h1 class="text-5xl sm:text-6xl font-bold leading-tight tracking-tight mb-6">
          We spent 25 years building websites. This kept happening.
        </h1>
        <p class="text-lg text-slate-300 leading-relaxed mb-4">
          After hundreds of launches, migrations, and client handoffs, a pattern emerged that was hard to dismiss. Well-executed projects would run into the same operational wall, often at the worst possible moment: nobody had a clear picture of who actually controlled the infrastructure behind the site.
        </p>
        <p class="text-base text-slate-500 leading-relaxed">
          SiteGov was built as a direct response to that gap, not as a theory, but from having been in these situations too many times to count.
        </p>
      </div>
    </div>
  </section>

  <!-- The Pattern -->
  <section class="relative border-b border-slate-100 py-20 paper-grain">

    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-2xl mb-14">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">The pattern</p>
        <h2 class="text-3xl sm:text-4xl font-bold leading-tight text-slate-900">The same situations. Different clients. Different years.</h2>
        <p class="text-slate-500 text-lg leading-relaxed mt-4">Working with clients long enough, you start to recognize these moments. Different projects, different industries, different years. The same underlying problem.</p>
      </div>

      <!-- Launch day timeline -->
      <div class="bg-white p-6 frame-teal mb-10 overflow-x-auto">
        <p class="text-[10px] font-mono text-slate-400 uppercase tracking-widest mb-6">Project timeline</p>
        <div class="min-w-[520px]">
          <div class="relative flex items-start">
            <!-- Connector line -->
            <div class="absolute top-[13px] h-px bg-slate-200" style="left:10%; right:10%;"></div>
            <!-- Broken red segment before launch -->
            <div class="absolute top-[12px] h-[3px]" style="left:66%; right:10%; background-image: repeating-linear-gradient(90deg,#ef4444 0,#ef4444 4px,transparent 4px,transparent 8px);"></div>

            <!-- Step 1: Project Approved -->
            <div class="relative z-10 flex flex-col items-center flex-1">
              <div class="w-7 h-7 rounded-full border-2 bg-white border-teal-500 flex items-center justify-center text-teal-500 text-[10px]">&#10003;</div>
              <span class="text-[9px] font-mono mt-2 text-center leading-tight text-slate-400">Project<br>Approved</span>
            </div>
            <!-- Step 2: Design -->
            <div class="relative z-10 flex flex-col items-center flex-1">
              <div class="w-7 h-7 rounded-full border-2 bg-white border-teal-500 flex items-center justify-center text-teal-500 text-[10px]">&#10003;</div>
              <span class="text-[9px] font-mono mt-2 text-center leading-tight text-slate-400">Design<br>Complete</span>
            </div>
            <!-- Step 3: Development -->
            <div class="relative z-10 flex flex-col items-center flex-1">
              <div class="w-7 h-7 rounded-full border-2 bg-white border-teal-500 flex items-center justify-center text-teal-500 text-[10px]">&#10003;</div>
              <span class="text-[9px] font-mono mt-2 text-center leading-tight text-slate-400">Development<br>Complete</span>
            </div>
            <!-- Step 4: QA -->
            <div class="relative z-10 flex flex-col items-center flex-1">
              <div class="w-7 h-7 rounded-full border-2 bg-white border-teal-500 flex items-center justify-center text-teal-500 text-[10px]">&#10003;</div>
              <span class="text-[9px] font-mono mt-2 text-center leading-tight text-slate-400">QA<br>Complete</span>
            </div>
            <!-- Step 5: Launch Day - BLOCKED -->
            <div class="relative z-10 flex flex-col items-center flex-1">
              <div class="w-7 h-7 rounded-full border-2 bg-red-950 border-red-500 flex items-center justify-center text-red-400 text-[11px] font-bold">!</div>
              <span class="text-[9px] font-mono mt-2 text-center leading-tight text-red-500">Launch<br>Day</span>
            </div>
          </div>

          <div class="flex justify-end mt-4">
            <div class="inline-flex items-center gap-2 px-3 py-2 bg-red-50 border border-red-200 rounded text-xs text-red-600 font-mono">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>
              DNS access missing &nbsp;&middot;&nbsp; Registrar login unknown &nbsp;&middot;&nbsp; Project blocked
            </div>
          </div>
        </div>
      </div>

      <!-- Observation cards -->
      <div class="grid md:grid-cols-3 gap-6">

        <div class="bg-white p-6 frame-teal">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-dashed border-slate-200">
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">OBS &middot; 001</span>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono text-slate-500">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>LAUNCH
            </span>
          </div>
          <p class="text-slate-800 text-sm font-semibold mb-3 leading-snug">DNS access missing on launch day</p>
          <p class="text-slate-500 text-sm leading-relaxed">The site is ready. The client is ready. The DNS is controlled by someone who left eight months ago. Nobody documented that the nameservers were pointing to the old host. Everything was visible before the project started.</p>
        </div>

        <div class="bg-white p-6 frame-teal">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-dashed border-slate-200">
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">OBS &middot; 002</span>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono text-slate-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>RENEWAL
            </span>
          </div>
          <p class="text-slate-800 text-sm font-semibold mb-3 leading-snug">Domain renewal notices sent to abandoned inboxes</p>
          <p class="text-slate-500 text-sm leading-relaxed">The domain was registered under the founder&rsquo;s personal Gmail from 2014. The account still exists. Nobody checks it. The renewal is automatic, until the card expires.</p>
        </div>

        <div class="bg-white p-6 frame-teal">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-dashed border-slate-200">
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">OBS &middot; 003</span>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono text-slate-500">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500 shrink-0"></span>TURNOVER
            </span>
          </div>
          <p class="text-slate-800 text-sm font-semibold mb-3 leading-snug">Former employee still owns the registrar account</p>
          <p class="text-slate-500 text-sm leading-relaxed">Someone leaves the company. Their email is still the primary contact on three registrar accounts. Everything is fine until someone needs to change DNS, renew a domain, or transfer a registrar.</p>
        </div>

        <div class="bg-white p-6 frame-teal">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-dashed border-slate-200">
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">OBS &middot; 004</span>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono text-slate-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>HANDOFF
            </span>
          </div>
          <p class="text-slate-800 text-sm font-semibold mb-3 leading-snug">Agencies inheriting undocumented infrastructure</p>
          <p class="text-slate-500 text-sm leading-relaxed">A new agency takes over. The outgoing team shares a list of logins in a Google doc. Some are current. Some aren&rsquo;t. The hosting is on a personal credit card. The DNS is &ldquo;probably GoDaddy.&rdquo;</p>
        </div>

        <div class="bg-white p-6 frame-teal">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-dashed border-slate-200">
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">OBS &middot; 005</span>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono text-slate-500">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-500 shrink-0"></span>ACCESS
            </span>
          </div>
          <p class="text-slate-800 text-sm font-semibold mb-3 leading-snug">Hosting tied to a personal account</p>
          <p class="text-slate-500 text-sm leading-relaxed">The hosting is under a developer&rsquo;s personal account. They moved on two years ago. The billing still works. Access recovery does not. Resolving it means a support ticket and weeks of back-and-forth.</p>
        </div>

        <div class="bg-white p-6 frame-teal">
          <div class="flex items-center justify-between mb-4 pb-3 border-b border-dashed border-slate-200">
            <span class="text-[10px] font-mono text-slate-400 uppercase tracking-widest">OBS &middot; 006</span>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 text-[10px] font-mono text-slate-500">
              <span class="w-1.5 h-1.5 rounded-full bg-slate-400 shrink-0"></span>VENDOR
            </span>
          </div>
          <p class="text-slate-800 text-sm font-semibold mb-3 leading-snug">Unknown vendor still controls the DNS</p>
          <p class="text-slate-500 text-sm leading-relaxed">An old vendor relationship ended. The nameservers still point to their infrastructure. Nobody realized. It was fine, until the vendor&rsquo;s system had an outage and the client&rsquo;s email went down for a day.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- How This Started -->
  <section class="relative py-24 bg-slate-950 text-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-4">How this started</p>
          <h2 class="text-4xl font-bold leading-tight mb-6 text-white">
            Years of good work running into the same operational wall.
          </h2>
          <p class="text-slate-400 text-lg leading-relaxed mb-4">
            The projects that led to SiteGov weren&rsquo;t failures. That&rsquo;s what makes the pattern worth talking about. The work was solid. The code shipped. The design was approved. The client was happy.
          </p>
          <p class="text-slate-400 text-base leading-relaxed mb-4">
            And then, at the exact moment it mattered most (launch day, a migration, a handoff, an emergency), something outside the project would surface. Who controls the DNS? Where&rsquo;s the registrar login? Whose personal account is hosting tied to? Is that vendor relationship still active?
          </p>
          <p class="text-slate-400 text-base leading-relaxed mb-4">
            These situations aren&rsquo;t failures of craft. They&rsquo;re failures of documentation. Preventable, but only if someone had thought to capture the information before it was needed.
          </p>
          <div class="border-l-2 border-slate-700 pl-5 mt-6">
            <p class="text-slate-300 text-sm leading-relaxed mb-3">
              One launch was delayed by more than a week because nobody knew how to access the client&rsquo;s Cloudflare account. It wasn&rsquo;t an unusual situation. It was one of many that made us realize there had to be a better way to document and manage infrastructure ownership.
            </p>
            <p class="text-slate-500 text-sm">That realization eventually became SiteGov.</p>
          </div>
        </div>

        <!-- Network diagram -->
        <div class="flex items-center justify-center">
