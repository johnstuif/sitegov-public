              <div class="text-right">
                <p class="text-slate-800 text-sm font-medium">Kenny Loggins</p>
                <p class="text-slate-400 text-xs">kenny@kennyloggins.com</p>
              </div>
            </div>
            <div class="flex items-start justify-between py-3 border-b border-slate-200">
              <span class="text-slate-500 text-xs uppercase tracking-wider pt-0.5">Backup Admin</span>
              <div class="text-right">
                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-amber-100 text-amber-700">Not documented</span>
              </div>
            </div>
            <div class="flex items-start justify-between py-3 border-b border-slate-200">
              <span class="text-slate-500 text-xs uppercase tracking-wider pt-0.5">MFA Status</span>
