---
export const prerender = true;
import BaseLayout from '../layouts/BaseLayout.astro';
import { APP_URL } from '../config';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: "What's included in the free plan?",
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The free plan lets you track up to 3 domains across unlimited clients, with full infrastructure scanning, findings, and a Control Score. It\'s free forever — no trial period, no credit card. Paid plans start at $19/month for up to 10 domains.',
      },
    },
    {
      '@type': 'Question',
      name: 'What counts as a domain?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Each hostname you add to SiteGov counts as one domain. If you track both acmebuilders.com and www.acmebuilders.com, that\'s two domains. Root domain governance data (registrar, DNS, WHOIS) is shared across subdomains of the same root, so you\'re not duplicating effort.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I change plans later?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Upgrade or downgrade at any time. If you upgrade mid-cycle, you\'re prorated for the remainder of the month. If you downgrade and have more domains than your new plan allows, you\'ll be prompted to remove the excess before the change takes effect.',
      },
    },
    {
      '@type': 'Question',
      name: 'What happens to my data if I cancel?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Your governance records belong to the domain owner, not us. On cancellation, you can export your full record set before your account closes. Nothing is deleted for 30 days after cancellation in case you want to reactivate or export.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you offer annual billing?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Annual plans are available with two months free. Email hello@sitegov.io to get set up on annual billing.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a discount for larger agencies?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'If the Agency plan doesn\'t fit your situation (unusually large portfolio or specific team structure), get in touch at hello@sitegov.io and we\'ll work something out.',
      },
    },
  ],
};
---

<BaseLayout
  title="Pricing for Website Infrastructure Tracking | SiteGov"
  description="Start free with 3 domains, no credit card. Paid plans from $19/month for agencies tracking DNS, hosting, SSL, registrar, and email across client portfolios."
  currentPage="Pricing"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqSchema)} />

  <!-- Hero -->
  <section class="bg-slate-950 text-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="max-w-3xl">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-500 mb-4">Pricing</p>
        <h1 class="text-5xl font-bold leading-tight tracking-tight mb-6">
          Simple pricing. No surprises.
        </h1>
        <p class="text-lg text-slate-400 leading-relaxed">
          Start free — no credit card, no time limit. Track up to 3 domains forever. Upgrade when your portfolio grows.
        </p>
      </div>
    </div>
  </section>

  <!-- Pricing tiers -->
  <section class="py-24 border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6">

      <!-- Free tier — full width above paid plans -->
      <div class="mb-6 flex justify-center">
        <div class="bg-slate-50 border border-slate-200 p-6 flex flex-col sm:flex-row sm:items-center gap-6 w-full">
          <div class="flex-1">
            <div class="flex items-baseline gap-3 mb-1">
              <h2 class="text-slate-900 font-semibold text-lg">Free</h2>
              <span class="text-2xl font-bold text-slate-900">$0</span>
              <span class="text-slate-400 text-sm">/ forever</span>
            </div>
            <p class="text-slate-500 text-sm">Up to 3 domains &middot; Unlimited clients &middot; Full infrastructure scan &middot; Control Score &amp; findings. No credit card. No time limit.</p>
          </div>
          <a href={`${APP_URL}/users/sign_up`} class="inline-flex items-center justify-center px-5 py-2.5 bg-white text-slate-900 text-sm font-semibold rounded-lg border border-slate-300 hover:border-slate-500 transition-colors whitespace-nowrap shrink-0">
            Start free
          </a>
        </div>
      </div>

      <div class="grid md:grid-cols-3 gap-6 mb-12">

        <!-- Starter -->
        <div class="bg-white p-8 flex flex-col frame-teal">
          <div class="mb-6">
            <h2 class="text-slate-900 font-semibold text-lg mb-1">Starter</h2>
            <p class="text-slate-500 text-sm leading-relaxed">For agencies with a handful of clients who want to stop guessing.</p>
          </div>
          <div class="mb-8">
            <span class="text-4xl font-bold text-slate-900">$19</span>
            <span class="text-slate-500 text-sm ml-1">/ month</span>
            <p class="text-slate-400 text-xs mt-1">Billed monthly. Cancel anytime.</p>
          </div>
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2.5 text-slate-600 text-sm">
              <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Up to 10 domains
            </li>
            <li class="flex items-start gap-2.5 text-slate-600 text-sm">
              <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Unlimited clients
            </li>
            <li class="flex items-start gap-2.5 text-slate-600 text-sm">
              <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Full infrastructure scan (DNS, SSL, registrar, hosting, email)
            </li>
            <li class="flex items-start gap-2.5 text-slate-600 text-sm">
              <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Governance records per asset
            </li>
            <li class="flex items-start gap-2.5 text-slate-600 text-sm">
              <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Control Score per domain (0&ndash;100)
            </li>
          </ul>
          <a href={`${APP_URL}/users/sign_up`} class="inline-flex items-center justify-center px-5 py-3 bg-slate-900 text-white text-sm font-semibold rounded-lg hover:bg-slate-700 transition-colors">
            Get started
          </a>
        </div>

        <!-- Growth -->
        <div class="bg-slate-900 p-8 flex flex-col relative frame-amber">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-teal-400 text-slate-900">Most popular</span>
          </div>
          <div class="mb-6">
            <h2 class="text-white font-semibold text-lg mb-1">Growth</h2>
            <p class="text-slate-400 text-sm leading-relaxed">For growing agencies tracking a full client portfolio.</p>
          </div>
          <div class="mb-8">
            <span class="text-4xl font-bold text-white">$49</span>
            <span class="text-slate-400 text-sm ml-1">/ month</span>
            <p class="text-slate-500 text-xs mt-1">Billed monthly. Cancel anytime.</p>
          </div>
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2.5 text-slate-300 text-sm">
              <svg class="w-4 h-4 text-teal-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Up to 35 domains
            </li>
            <li class="flex items-start gap-2.5 text-slate-300 text-sm">
              <svg class="w-4 h-4 text-teal-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Everything in Starter
            </li>
            <li class="flex items-start gap-2.5 text-slate-300 text-sm">
              <svg class="w-4 h-4 text-teal-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Infrastructure change alerts
            </li>
            <li class="flex items-start gap-2.5 text-slate-300 text-sm">
              <svg class="w-4 h-4 text-teal-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Weekly risk digest emails
            </li>
            <li class="flex items-start gap-2.5 text-slate-300 text-sm">
              <svg class="w-4 h-4 text-teal-400 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Risk timeline per domain
            </li>
          </ul>
          <a href={`${APP_URL}/users/sign_up`} class="inline-flex items-center justify-center px-5 py-3 bg-white text-slate-900 text-sm font-semibold rounded-lg hover:bg-slate-100 transition-colors">
            Get started
          </a>
        </div>

        <!-- Agency -->
        <div class="bg-white p-8 flex flex-col frame-teal">
          <div class="mb-6">
            <h2 class="text-slate-900 font-semibold text-lg mb-1">Agency</h2>
            <p class="text-slate-500 text-sm leading-relaxed">For larger agencies managing infrastructure across hundreds of client sites.</p>
          </div>
          <div class="mb-8">
            <span class="text-4xl font-bold text-slate-900">$99</span>
            <span class="text-slate-500 text-sm ml-1">/ month</span>
            <p class="text-slate-400 text-xs mt-1">Billed monthly. Cancel anytime.</p>
          </div>
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2.5 text-slate-600 text-sm">
              <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Up to 100 domains
            </li>
            <li class="flex items-start gap-2.5 text-slate-600 text-sm">
              <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Everything in Growth
            </li>
            <li class="flex items-start gap-2.5 text-slate-600 text-sm">
              <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              CSV &amp; bulk import
            </li>
            <li class="flex items-start gap-2.5 text-slate-600 text-sm">
              <svg class="w-4 h-4 text-teal-500 mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg>
              Priority support
            </li>
          </ul>
          <a href={`${APP_URL}/users/sign_up`} class="inline-flex items-center justify-center px-5 py-3 bg-slate-900 text-white text-sm font-semibold rounded-lg hover:bg-slate-700 transition-colors">
            Get started
          </a>
        </div>

      </div>

      <!-- Enterprise callout — mirrors free tier above -->
      <div class="flex justify-center">
        <div class="bg-slate-50 border border-slate-200 p-6 flex flex-col sm:flex-row sm:items-center gap-6 w-full">
          <div class="flex-1">
            <div class="flex items-baseline gap-3 mb-1">
              <h2 class="text-slate-900 font-semibold text-lg">Enterprise</h2>
            </div>
            <p class="text-slate-500 text-sm">Managing more than 100 domains? We offer custom pricing for larger portfolios. No sales call required.</p>
          </div>
          <a href="mailto:hello@sitegov.io" class="inline-flex items-center justify-center px-5 py-2.5 bg-white text-slate-900 text-sm font-semibold rounded-lg border border-slate-300 hover:border-slate-500 transition-colors whitespace-nowrap shrink-0">
            Get in touch
          </a>
        </div>
      </div>

    </div>
  </section>

  <!-- Free scan callout -->
  <section class="py-20 border-b border-slate-100">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">Start free, stay free</p>
          <h2 class="text-3xl font-bold leading-tight mb-4">Up to 3 domains, free forever.</h2>
          <p class="text-slate-500 text-lg leading-relaxed mb-6">
            Sign up, add your domains, and run a full infrastructure scan — no credit card, no trial clock. If 3 domains is all you need, it&rsquo;s free for as long as you use it.
          </p>
          <a href={`${APP_URL}/users/sign_up`} class="inline-flex items-center justify-center px-6 py-3.5 bg-slate-900 text-white text-sm font-semibold rounded-lg hover:bg-slate-700 transition-colors">
            Start free
          </a>
          <p class="text-xs text-slate-400 mt-3">No credit card required. No time limit.</p>
        </div>
        <div class="bg-slate-50 p-6 frame-teal">
          <p class="text-slate-400 text-xs uppercase tracking-widest mb-4">What the free scan shows you</p>
          <ul class="space-y-3">
            <li class="flex items-start gap-3 text-slate-600 text-sm">
              <span class="w-1.5 h-1.5 mt-1.5 rounded-full bg-teal-500 shrink-0"></span>
              Registrar, DNS provider, hosting platform, SSL authority, and email system, all from live data
            </li>
            <li class="flex items-start gap-3 text-slate-600 text-sm">
              <span class="w-1.5 h-1.5 mt-1.5 rounded-full bg-teal-500 shrink-0"></span>
              SSL expiry status and whether auto-renew is detectable
            </li>
            <li class="flex items-start gap-3 text-slate-600 text-sm">
              <span class="w-1.5 h-1.5 mt-1.5 rounded-full bg-teal-500 shrink-0"></span>
              DNSSEC and email authentication (SPF, DMARC) status
            </li>
            <li class="flex items-start gap-3 text-slate-600 text-sm">
              <span class="w-1.5 h-1.5 mt-1.5 rounded-full bg-teal-500 shrink-0"></span>
              Open infrastructure findings ranked by severity
            </li>
            <li class="flex items-start gap-3 text-slate-600 text-sm">
              <span class="w-1.5 h-1.5 mt-1.5 rounded-full bg-teal-500 shrink-0"></span>
              Control Score (0&ndash;100) showing overall infrastructure health
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white border-t border-slate-100 py-20">
    <div class="max-w-3xl mx-auto px-6">
      <div class="mb-12">
        <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-4">Pricing questions</p>
        <h2 class="text-3xl font-bold leading-tight">What people ask before signing up.</h2>
      </div>
      <div class="divide-y divide-slate-100">

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">What&rsquo;s included in the free plan?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">The free plan lets you track up to 3 domains across unlimited clients, with full infrastructure scanning, findings, and a Control Score. It&rsquo;s free forever — no trial period, no credit card. Paid plans start at $19/month for up to 10 domains. When you need more, you&rsquo;ll be prompted to upgrade.</p>
        </div>

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">What counts as a domain?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Each hostname you add to SiteGov counts as one domain. If you track both acmebuilders.com and www.acmebuilders.com, that&rsquo;s two domains. Root domain governance data (registrar, DNS, WHOIS) is shared across subdomains of the same root, so you&rsquo;re not duplicating effort, just tracking coverage where it matters.</p>
        </div>

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">Can I change plans later?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Yes. Upgrade or downgrade at any time. If you upgrade mid-cycle, you&rsquo;re prorated for the remainder of the month. If you downgrade and have more domains than your new plan allows, you&rsquo;ll be prompted to remove the excess before the change takes effect.</p>
        </div>

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">What happens to my data if I cancel?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Your governance records belong to the domain owner, not us. On cancellation, you can export your full record set before your account closes. Nothing is deleted for 30 days after cancellation in case you want to reactivate or export.</p>
        </div>

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">Do you offer annual billing?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">Annual plans are available with two months free. <a href="mailto:hello@sitegov.io" class="text-slate-900 font-medium hover:underline">Email us</a> to get set up on annual billing.</p>
        </div>

        <div class="py-7">
          <h3 class="text-slate-900 font-semibold mb-3">Is there a discount for larger agencies?</h3>
          <p class="text-slate-500 text-sm leading-relaxed">If the Agency plan doesn&rsquo;t fit your situation (unusually large portfolio or specific team structure), <a href="mailto:hello@sitegov.io" class="text-slate-900 font-medium hover:underline">get in touch</a> and we&rsquo;ll work something out.</p>
        </div>

      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="bg-slate-50 border-t border-slate-200 py-24">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <p class="text-xs font-semibold uppercase tracking-widest text-slate-400 mb-6">Get started</p>
      <h2 class="text-4xl font-bold leading-tight mb-6">
        Every client has a gap. Find yours in five minutes.
      </h2>
      <p class="text-slate-500 text-xl mb-10 leading-relaxed">
        Up to 3 domains. Unlimited clients. Free forever. No credit card required.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href={`${APP_URL}/users/sign_up`} class="inline-flex items-center justify-center px-8 py-4 bg-slate-900 text-white text-sm font-semibold rounded-lg hover:bg-slate-700 transition-colors">
          Start free
        </a>
        <a href="/use-cases" class="inline-flex items-center justify-center px-8 py-4 bg-white text-slate-700 text-sm font-medium rounded-lg border border-slate-200 hover:border-slate-400 transition-colors">
          See use cases
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
